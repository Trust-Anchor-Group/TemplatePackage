<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Root\TemplatePackage\**" />
    <EmbeddedResource Remove="Root\TemplatePackage\**" />
    <None Remove="Root\TemplatePackage\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="TAG.Package.Template.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Root\TemplatePackage\Settings.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TAG.Package.Template.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Waher.IoTGateway" Version="3.8.1" />
    <PackageReference Include="Waher.Runtime.Inventory" Version="1.4.6" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec
      Command="&quot;C:\My Projects\IoTGateway\Utilities\Waher.Utility.Install\bin\$(ConfigurationName)\net8.0\win-x86\Waher.Utility.Install.exe&quot; -m &quot;C:\My Projects\TemplatePackage\TAG.Package.Template\bin\$(ConfigurationName)\netstandard2.1\TAG.Package.Template.manifest&quot; -s &quot;C:\My Projects\IoTGateway\Waher.IoTGateway.Console\bin\$(ConfigurationName)\net8.0\Waher.IoTGateway.Console.dll&quot; -d &quot;C:\ProgramData\IoT Gateway Dev&quot;&#xD;&#xA;" />
  </Target>

</Project>